# Names the design expects. Put the real values in your platform's secret store
# (GitHub Actions secrets, Cloudflare Worker secrets), never in this repository.
GEMINI_API_KEY=        # the oracle job (its own project, so it has its own quota)
NEWS_API_KEY=          # the prefetch job's news-API queries
EMAIL_API_KEY=         # the Worker's email sender
DISPATCH_TOKEN=        # lets the Worker's cron dispatch the prefetch workflow
SEND_TOKEN=            # required by the Worker before it sends anything to subscribers
